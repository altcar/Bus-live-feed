{
  "name": "harry-stoke-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live southbound bus departures for Harry Stoke (m1, m4, T1)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --env-file-if-exists=.env --test",
    "build:static": "node --env-file-if-exists=.env scripts/build-static.mjs",
    "build:worker": "node scripts/build-worker-assets.mjs",
    "build:pages": "node scripts/build-pages-redirect.mjs",
    "preview:static": "node scripts/serve-static.mjs"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "express": "^5.1.0"
  }
}
