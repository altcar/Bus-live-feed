# ── Where to get API keys ────────────────────────────────────────────────────
# TransportAPI (TAPI_APP_ID / TAPI_APP_KEY)
#   Sign up:            https://developer.transportapi.com/signup
#   Sign in / your apps: https://developer.transportapi.com/my-apps
#   Sign in page:       https://developer.transportapi.com/login
#
# BODS (optional: this version reads BODS data through bustimes.org, so no
# BODS key is required. Use this if you switch to the direct BODS feed.)
#   Sign up:            https://data.bus-data.dft.gov.uk/account/signup/
#   Your API key:       https://data.bus-data.dft.gov.uk/account/
#
# bustimes.org needs no key.
# ─────────────────────────────────────────────────────────────────────────────

# Primary live feed: bustimes.org (BODS). TAPI is manual-only.
PRIMARY_PROVIDER=bustimes

# TransportAPI credentials (server-side only).
TAPI_APP_ID=
TAPI_APP_KEY=

# TAPI manual-button budget, well below the 30/day plan.
TAPI_DAILY_LIMIT=28

# Snapshot cache lifetime (seconds) and double-click debounce.
TAPI_CACHE_SECONDS=21600
TAPI_MIN_INTERVAL_SECONDS=10

# Stops: 017000054 = Harry Stoke S-bound, 017000053 = Harry Stoke N-bound,
# 0100BRP90372 = The Centre C2 (N-bound).
STOPS=017000054,017000053,0100BRP90372
ROUTES=m1,m4,T1,m3

PORT=3000
HOST=127.0.0.1
REFRESH_SECONDS=60
HORIZON_HOURS=3
